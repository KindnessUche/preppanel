# Copy this to .env before running `docker compose up --build`.
#
# You do NOT need any AI keys here. Open the app -> Account -> "API keys" and add your own
# Claude / ChatGPT / Gemini / Grok key (reasoning model) and AssemblyAI key (voice). They stay in
# your browser and are never stored by the backend.
#
# Optional dev convenience: server-side default keys used only when a user hasn't set their own.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional - a default is provided for local/portfolio use. Override for anything
# beyond local demoing.
JWT_SECRET=local-dev-only-secret-key-change-me-please-32bytes+
