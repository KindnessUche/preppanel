# Copy this to .env before running `docker compose up --build`.
#
# GROQ_API_KEY: free, no card required - https://console.groq.com
# GEMINI_API_KEY: free, no card required - https://aistudio.google.com (optional -
#   only used as a fallback if Groq is unavailable; the app still works without it)

GROQ_API_KEY=
GEMINI_API_KEY=

# Optional - a default is provided for local/portfolio use. Override for anything
# beyond local demoing.
JWT_SECRET=local-dev-only-secret-key-change-me-please-32bytes+
